<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Akshar Tod Kar Sikhane Wala Blackboard</title>
    <style>
        * {
            box-sizing: border-box;
        }
        body {
            margin: 0;
            padding: 0;
            background-color: #121212;
            font-family: 'Nirmala UI', 'Mangal', 'Arial', sans-serif;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            color: #fff;
            padding: 16px;
        }

        h2 {
            margin-bottom: 2px;
            color: #ffd700;
            text-align: center;
            font-weight: 500;
        }

        .instruction {
            color: #b0bec5;
            font-size: 15px;
            margin-bottom: 16px;
            text-align: center;
            max-width: 600px;
            line-height: 1.5;
        }

        /* Blackboard */
        .blackboard {
            width: 92%;
            max-width: 850px;
            min-height: 320px;
            background: #1b382b;
            border: 14px solid #5c4033;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.7);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 30px 15px;
            position: relative;
        }

        .chalk-container {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            align-items: center;
            gap: 15px;
            min-height: 160px;
            padding: 10px 0;
            width: 100%;
        }

        /* Character Box - Individual Part */
        .char-box {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            background: rgba(255, 255, 255, 0.08);
            border: 2px dashed rgba(255, 255, 255, 0.2);
            border-radius: 8px;
            padding: 10px 12px;
            min-width: 65px;
            opacity: 0;
            transform: scale(0.2);
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.4);
        }

        .char-box.visible {
            opacity: 1;
            transform: scale(1);
        }

        /* Top Part (Base Akshar) */
        .box-top {
            font-family: 'Mangal', 'Nirmala UI', sans-serif;
            font-size: 45px;
            font-weight: 700;
            color: #ffffff;
            text-shadow: 2px 2px 5px rgba(0, 0, 0, 0.8);
        }

        /* Bottom Part (Matra or Full form indication) */
        .box-bottom {
            font-family: 'Mangal', 'Nirmala UI', sans-serif;
            font-size: 22px;
            font-weight: 600;
            color: #ffeb3b;
            margin-top: 4px;
            min-height: 28px;
        }

        /* Status & Audio Guide */
        .status-box {
            margin-top: 22px;
            font-size: 22px;
            color: #00e676;
            font-weight: 600;
            min-height: 42px;
            text-align: center;
            padding: 0 10px;
        }
        .status-box .highlight {
            color: #ffd700;
        }

        /* Mic Button */
        .mic-btn {
            margin-top: 18px;
            background: #ff5722;
            color: #fff;
            border: none;
            padding: 14px 34px;
            font-size: 19px;
            border-radius: 40px;
            cursor: pointer;
            box-shadow: 0 4px 14px rgba(255, 87, 34, 0.4);
            transition: background 0.3s, transform 0.15s;
            font-weight: 600;
        }
        .mic-btn:hover {
            background: #e64a19;
            transform: scale(1.02);
        }
        .mic-btn.listening {
            background: #d32f2f;
            animation: pulse 1.4s infinite;
        }

        @keyframes pulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.06); }
            100% { transform: scale(1); }
        }
    </style>
</head>
<body>

    <h2>🧑‍🏫 बच्चों का जादुई अक्षर-तोड़ ब्लैकबोर्ड</h2>
    <p class="instruction">🎤 माइक बटन दबाएँ और शब्द बोलें — <strong>जैसे:</strong> पगली, सोना, कमल, आम</p>

    <div class="blackboard">
        <div class="chalk-container" id="chalkContainer"></div>
    </div>

    <div class="status-box" id="statusText">🎙️ माइक ऑन करके बोलना शुरू करें…</div>
    <button class="mic-btn" id="micBtn">🎤 माइक ऑन करें</button>

    <script>
        (function() {
            'use strict';

            const chalkContainer = document.getElementById('chalkContainer');
            const statusText = document.getElementById('statusText');
            const micBtn = document.getElementById('micBtn');

            let recognition = null;
            let isListening = false;
            let isAnimating = false;

            function speakText(text, callback) {
                if (!('speechSynthesis' in window)) {
                    if (callback) callback();
                    return;
                }
                window.speechSynthesis.cancel();
                const utterance = new SpeechSynthesisUtterance(text);
                utterance.lang = 'hi-IN';
                utterance.rate = 0.7;
                if (callback) utterance.onend = callback;
                window.speechSynthesis.speak(utterance);
            }

            // Word ko sahi akshar aur matra ke tukdo me todna (jaise प + ् + ग + ल + ी)
            function breakWordIntoParts(word) {
                const parts = [];
                let i = 0;
                const chars = [...word];

                while (i < chars.length) {
                    let ch = chars[i];
                    if (ch === ' ' || ch === '\u200B' || ch === '\u00A0') {
                        i++;
                        continue;
                    }

                    let displayChar = ch;
                    let label = "अक्षर";

                    if (i + 1 < chars.length) {
                        const next = chars[i + 1];
                        const code = next.charCodeAt(0);
                        const isCombining = (
                            (code >= 0x0900 && code <= 0x0954) ||
                            (code >= 0x0970 && code <= 0x097F) ||
                            code === 0x093C || 
                            code === 0x094D 
                        );
                        if (isCombining) {
                            displayChar = ch + next;
                            label = "मात्रयुक्त";
                            i++;
                        }
                    }

                    parts.push({ char: displayChar, label: label });
                    i++;
                }
                return parts;
            }

            function animateWord(word) {
                if (isAnimating) return;
                isAnimating = true;

                chalkContainer.innerHTML = '';
                statusText.innerHTML = `✨ <span class="highlight">${word}</span> — तोड़कर सीखना शुरू…`;

                const parts = breakWordIntoParts(word);
                if (parts.length === 0) {
                    isAnimating = false;
                    return;
                }

                const boxes = [];
                parts.forEach((part) => {
                    const box = document.createElement('div');
                    box.className = 'char-box';

                    const topDiv = document.createElement('div');
                    topDiv.className = 'box-top';
                    topDiv.textContent = part.char;

                    const bottomDiv = document.createElement('div');
                    bottomDiv.className = 'box-bottom';
                    bottomDiv.textContent = part.label;

                    box.appendChild(topDiv);
                    box.appendChild(bottomDiv);
                    chalkContainer.appendChild(box);
                    boxes.push(box);
                });

                let currentIndex = 0;

                function processPart(index) {
                    if (index >= boxes.length) {
                        statusText.innerHTML = `✅ पूरा शब्द बना: <strong style="color:#00e676;font-size:1.2em;">${word}</strong>`;
                        speakText(`मिलकर बना, ${word}`, () => {
                            isAnimating = false;
                            statusText.innerHTML = `🎉 <span class="highlight">${word}</span> — बहुत बढ़िया! 🔁 फिर से बोलें।`;
                        });
                        return;
                    }

                    const box = boxes[index];
                    const part = parts[index];

                    box.classList.add('visible');
                    statusText.innerHTML = `🔤 टुकड़ा: <strong class="highlight">${part.char}</strong>`;

                    speakText(part.char, () => {
                        setTimeout(() => {
                            currentIndex++;
                            processPart(currentIndex);
                        }, 400);
                    });
                }

                processPart(0);
            }

            const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
            if (SpeechRecognition) {
                recognition = new SpeechRecognition();
                recognition.lang = 'hi-IN';
                recognition.interimResults = false;
                recognition.maxAlternatives = 1;

                recognition.onstart = function() {
                    isListening = true;
                    micBtn.classList.add('listening');
                    micBtn.textContent = '🛑 सुन रहा हूँ…';
                    statusText.textContent = '🎧 सुन रहा हूँ… बोलिए!';
                };

                recognition.onresult = function(event) {
                    const transcript = event.results[0][0].transcript.trim();
                    if (transcript) animateWord(transcript);
                };

                recognition.onerror = function() {
                    stopListeningState();
                };

                recognition.onend = function() {
                    stopListeningState();
                };
            }

            window.toggleListening = function() {
                if (!recognition) return;
                if (isListening) {
                    recognition.stop();
                } else {
                    if (!isAnimating) chalkContainer.innerHTML = '';
                    try { recognition.start(); } catch (e) {}
                }
            };

            function stopListeningState() {
                isListening = false;
                micBtn.classList.remove('listening');
                micBtn.textContent = '🎤 माइक ऑन करें';
            }

            micBtn.addEventListener('click', window.toggleListening);
        })();
    </script>
</body>
</html>
